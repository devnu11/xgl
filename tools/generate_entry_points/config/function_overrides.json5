{
  // File Function Mappings and Enhanced Configurations
  // Each file contains an ordered list of functions and their enhanced specifications
  "files": {
    // Buffer operations - basic resource management
    "buffer": {
      "functions": [
        "vkDestroyBuffer",
        "vkBindBufferMemory", 
        "vkBindBufferMemory2",
        "vkGetBufferMemoryRequirements",
        "vkGetBufferMemoryRequirements2", 
        "vkGetBufferDeviceAddress",
        "vkGetBufferOpaqueCaptureAddress",
        "vkGetDeviceBufferMemoryRequirements",
      ],
      "enhanced": {
        "vkDestroyBuffer": {"method": "Destroy"},
        "vkBindBufferMemory": {"method": "BindMemory"},
        "vkGetBufferMemoryRequirements": {"method": "GetMemoryRequirements"},
        "vkGetBufferMemoryRequirements2": {"method": "GetMemoryRequirements"},
        "vkGetBufferDeviceAddress": {"method": "GpuVirtAddr"},  // Custom XGL method name
        "vkGetBufferOpaqueCaptureAddress": {"method": "GpuVirtAddr"},
      },
    },

    "cmd_buffer": {
      "functions": [
        "vkDestroyCommandBuffer",
        "vkBeginCommandBuffer",
        "vkEndCommandBuffer", 
