        "vkCmdBeginRenderPass2",
        "vkCmdNextSubpass2",
        "vkCmdEndRenderPass2",
      ],
      "enhanced": {
        "vkBeginCommandBuffer": {"method": "Begin"},
        "vkEndCommandBuffer": {"method": "End"},
        "vkResetCommandBuffer": {"method": "Reset"},
        "vkCmdDispatchBase": {"method": "DispatchOffset"},
        "vkCmdBlitImage2": {"method": "BlitImage"},
        "vkCmdCopyBuffer2": {"method": "CopyBuffer"},
        "vkCmdCopyBufferToImage2": {"method": "CopyBufferToImage"},
        "vkCmdCopyImage2": {"method": "CopyImage"},
        "vkCmdCopyImageToBuffer2": {"method": "CopyImageToBuffer"},
        "vkCmdResolveImage2": {"method": "ResolveImage"},
        "vkCmdBeginRenderPass2": {"method": "BeginRenderPass"},
        "vkCmdNextSubpass2": {"method": "NextSubpass"},
        "vkCmdEndRenderPass2": {"method": "EndRenderPass"},
        "vkCmdPipelineBarrier2": {"method": "PipelineBarrier"},
        "vkCmdSetEvent2": {"method": "SetEvent"},
        "vkCmdResetEvent2": {"method": "ResetEvent"},
        "vkCmdWaitEvents2": {"method": "WaitEvents"},
        "vkCmdWriteTimestamp2": {"method": "WriteTimestamp"},
