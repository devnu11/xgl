        "vkGetDeferredOperationResultKHR": {"method": "GetResult"},
        "vkGetDeferredOperationMaxConcurrencyKHR": {"method": "GetMaxConcurrency"},
        "vkDeferredOperationJoinKHR": {"method": "Join"},  // The function that started this whole migration!
