      {"name": "vkGetRayTracingShaderGroupStackSizeKHR", "method": "GetRayTracingShaderGroupStackSize"}
    ],
    "pipeline_layout": [
      {"name": "vkDestroyPipelineLayout", "method": "Destroy"}
    ],
    "query_pool": [
      {"name": "vkDestroyQueryPool", "method": "Destroy"},
      {"name": "vkGetQueryPoolResults", "method": "GetResults"}
    ],
    "queue": [
      {"name": "vkQueueSubmit", "method": "Submit"},
      {"name": "vkQueueWaitIdle", "method": "WaitIdle"},
      {"name": "vkQueueBindSparse", "method": "BindSparse"},
      {"name": "vkQueuePresentKHR", "method": "Present"},
      {"name": "vkQueueSubmit2", "method": "Submit"}
    ],
    "render_pass": [
      {"name": "vkDestroyRenderPass", "method": "Destroy"},
      {"name": "vkGetRenderAreaGranularity", "method": "GetRenderAreaGranularity"}
    ],
    "sampler": [
