    ],
    "semaphore": [
      {"name": "vkDestroySemaphore", "method": "Destroy"},
      {"name": "vkGetSemaphoreCounterValue", "method": "GetCounterValue"},
      {"name": "vkWaitSemaphores", "impl": "success_only", "return": "VK_SUCCESS"},
