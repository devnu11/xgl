{
  // File Function Mappings and Enhanced Configurations
  // Each file contains an ordered list of functions and their enhanced specifications
  "files": {
    // Buffer operations - basic resource management
    "buffer": {
      "functions": [
        "vkDestroyBuffer",
        "vkBindBufferMemory", 
        "vkBindBufferMemory2",
        "vkGetBufferMemoryRequirements",
        "vkGetBufferMemoryRequirements2", 
        "vkGetBufferDeviceAddress",
        "vkGetBufferOpaqueCaptureAddress",
        "vkGetDeviceBufferMemoryRequirements",
      ],
      "enhanced": {
        "vkDestroyBuffer": {"method": "Destroy"},
        "vkBindBufferMemory": {"method": "BindMemory"},
        "vkGetBufferMemoryRequirements": {"method": "GetMemoryRequirements"},
        "vkGetBufferMemoryRequirements2": {"method": "GetMemoryRequirements"},
        "vkGetBufferDeviceAddress": {"method": "GpuVirtAddr"},  // Custom XGL method name
        "vkGetBufferOpaqueCaptureAddress": {"method": "GpuVirtAddr"},
      },
    },
    "buffer_view": {
      "functions": [
        "vkDestroyBufferView",
      ],
      "enhanced": {
        "vkDestroyBufferView": {"method": "Destroy"},
      },
    },
    // Command buffer operations - recording and execution
    "cmd_buffer": [
      {"name": "vkBeginCommandBuffer", "method": "Begin"},
      {"name": "vkEndCommandBuffer", "method": "End"},
      {"name": "vkResetCommandBuffer", "method": "Reset"},
      {"name": "vkCmdDispatchBase", "method": "DispatchOffset"},
      {"name": "vkCmdBlitImage2", "method": "BlitImage"},
      {"name": "vkCmdCopyBuffer2", "method": "CopyBuffer"},
      {"name": "vkCmdCopyBufferToImage2", "method": "CopyBufferToImage"},
      {"name": "vkCmdCopyImage2", "method": "CopyImage"},
      {"name": "vkCmdCopyImageToBuffer2", "method": "CopyImageToBuffer"},
      {"name": "vkCmdResolveImage2", "method": "ResolveImage"},
      {"name": "vkCmdBeginRenderPass2", "method": "BeginRenderPass"},
      {"name": "vkCmdNextSubpass2", "method": "NextSubpass"},
      {"name": "vkCmdEndRenderPass2", "method": "EndRenderPass"},
      {"name": "vkCmdPipelineBarrier2", "method": "PipelineBarrier"},
      {"name": "vkCmdSetEvent2", "method": "SetEvent"},
      {"name": "vkCmdResetEvent2", "method": "ResetEvent"},
      {"name": "vkCmdWaitEvents2", "method": "WaitEvents"},
      {"name": "vkCmdWriteTimestamp2", "method": "WriteTimestamp"},
      {"name": "vkCmdWriteBufferMarker2AMD", "method": "WriteBufferMarkerAMD"},
      {"name": "vkCmdBindVertexBuffers2", "method": "BindVertexBuffers"}
    ],
    "cmd_pool": [
      {"name": "vkDestroyCommandPool", "method": "Destroy"},
      {"name": "vkResetCommandPool", "method": "Reset"},
      {"name": "vkTrimCommandPool", "method": "Trim"}
    ],
    // Deferred operations for asynchronous execution
    "deferred_operation": [
      {"name": "vkDestroyDeferredOperationKHR", "method": "Destroy"},
      {"name": "vkGetDeferredOperationResultKHR", "method": "GetResult"},
      {"name": "vkGetDeferredOperationMaxConcurrencyKHR", "method": "GetMaxConcurrency"},
      {"name": "vkDeferredOperationJoinKHR", "method": "Join"},  // The function that started this whole migration!
    ],
    "descriptor_pool": [
      {"name": "vkDestroyDescriptorPool", "method": "Destroy"},
      {"name": "vkResetDescriptorPool", "method": "Reset"}
    ],
    "descriptor_set": [
      {"name": "vkFreeDescriptorSets", "method": "Free"},
      {"name": "vkUpdateDescriptorSets", "impl": "success_only", "return": "VK_SUCCESS"},
      {"name": "vkUpdateDescriptorSetWithTemplate", "method": "Update"},
      {"name": "vkUpdateDescriptorSetWithTemplateKHR", "method": "Update"}
    ],
    "descriptor_set_layout": [
      {"name": "vkDestroyDescriptorSetLayout", "method": "Destroy"},
      {"name": "vkGetDescriptorSetLayoutSupport", "method": "GetLayoutSupport"},
      {"name": "vkGetDescriptorSetLayoutSupportKHR", "method": "GetLayoutSupport"}
    ],
    // Core device operations
    "device": [
      {"name": "vkEnumerateDeviceLayerProperties", "impl": "success_only", "return": "VK_SUCCESS"},  // Stub - no layers to enumerate
    ],
    "fence": [
      {"name": "vkDestroyFence", "method": "Destroy"},
      {"name": "vkResetFences", "impl": "success_only", "return": "VK_SUCCESS"},
      {"name": "vkGetFenceStatus", "method": "GetStatus"},
      {"name": "vkWaitForFences", "impl": "success_only", "return": "VK_SUCCESS"}
    ],
    "framebuffer": [
      {"name": "vkDestroyFramebuffer", "method": "Destroy"}
    ],
    "image": [
      {"name": "vkDestroyImage", "method": "Destroy"},
      {"name": "vkGetImageMemoryRequirements", "method": "GetMemoryRequirements"},
      {"name": "vkGetImageMemoryRequirements2", "method": "GetMemoryRequirements"},
      {"name": "vkGetImageSparseMemoryRequirements", "method": "GetSparseMemoryRequirements"},
      {"name": "vkGetImageSparseMemoryRequirements2", "method": "GetSparseMemoryRequirements"},
      {"name": "vkBindImageMemory", "method": "BindMemory"},
      {"name": "vkGetImageSubresourceLayout", "method": "GetSubresourceLayout"}
    ],
    "image_view": [
      {"name": "vkDestroyImageView", "method": "Destroy"}
    ],
    "instance": [
      {"name": "vkDestroyInstance", "method": "Destroy"},
      {"name": "vkEnumeratePhysicalDevices", "method": "EnumeratePhysicalDevices"},
      {"name": "vkEnumerateInstanceExtensionProperties", "impl": "success_only", "return": "VK_SUCCESS"},
      {"name": "vkEnumerateInstanceLayerProperties", "impl": "success_only", "return": "VK_SUCCESS"},
      {"name": "vkEnumerateInstanceVersion", "impl": "success_only", "return": "VK_SUCCESS"}
    ],
    // Memory management operations
    "memory": [
      {"name": "vkFreeMemory", "method": "Free"},
      {"name": "vkMapMemory", "method": "Map"},
      {"name": "vkUnmapMemory", "method": "Unmap"},
      {"name": "vkMapMemory2", "method": "Map"},
      {"name": "vkUnmapMemory2", "method": "Unmap"},
      {"name": "vkFlushMappedMemoryRanges", "impl": "success_only", "return": "VK_SUCCESS"},  // No-op for XGL
      {"name": "vkInvalidateMappedMemoryRanges", "impl": "success_only", "return": "VK_SUCCESS"},  // No-op for XGL
      {"name": "vkGetDeviceMemoryCommitment", "method": "GetCommitment"},
      {"name": "vkGetMemoryFdKHR", "method": "GetMemoryFd"},
      {"name": "vkGetMemoryFdPropertiesKHR", "impl": "success_only", "return": "VK_SUCCESS"},  // Platform support stub
      {"name": "vkGetDeviceMemoryOpaqueCaptureAddress", "method": "GetOpaqueCaptureAddress"},
    ],
    "physical_device": [
      {"name": "vkGetPhysicalDeviceProperties2", "method": "GetDeviceProperties2"},
      {"name": "vkGetPhysicalDeviceMultisamplePropertiesEXT", "method": "GetDeviceMultisampleProperties"},
      {"name": "vkGetPhysicalDeviceQueueFamilyProperties2", "method": "GetQueueFamilyProperties"},
      {"name": "vkAcquireXlibDisplayEXT", "method": "AcquireXlibDisplay"},
      {"name": "vkGetRandROutputDisplayEXT", "method": "GetRandROutputDisplay"},
      {"name": "vkReleaseDisplayEXT", "method": "ReleaseDisplay"},
      {"name": "vkGetPhysicalDevicePresentRectanglesKHR", "method": "GetPhysicalDevicePresentRectangles"},
      {"name": "vkGetDisplayPlaneSupportedDisplaysKHR", "method": "GetDisplayPlaneSupportedDisplays"},
      {"name": "vkGetDisplayModePropertiesKHR", "method": "GetDisplayModeProperties"},
      {"name": "vkCreateDisplayModeKHR", "method": "CreateDisplayMode"},
      {"name": "vkGetDisplayPlaneCapabilitiesKHR", "method": "GetDisplayPlaneCapabilities"},
      {"name": "vkGetPhysicalDeviceDisplayProperties2KHR", "method": "GetDisplayProperties"},
      {"name": "vkGetPhysicalDeviceDisplayPlaneProperties2KHR", "method": "GetDisplayPlaneProperties"},
      {"name": "vkGetDisplayPlaneCapabilities2KHR", "method": "GetDisplayPlaneCapabilities"},
      {"name": "vkGetPhysicalDeviceToolProperties", "method": "GetPhysicalDeviceToolPropertiesEXT"},
      {"name": "vkGetPhysicalDeviceFragmentShadingRatesKHR", "method": "GetFragmentShadingRates"},
      {"name": "vkGetPhysicalDeviceCooperativeMatrixPropertiesKHR", "method": "GetPhysicalDeviceCooperativeMatrixPropertiesKHR"},
      {"name": "vkGetPhysicalDeviceSurfacePresentModesKHR", "method": "GetSurfacePresentModes"},
      {"name": "vkGetPhysicalDeviceProperties", "method": "GetDeviceProperties"},
      {"name": "vkEnumerateDeviceExtensionProperties", "method": "EnumerateExtensionProperties"}
    ],
    "pipeline": [
      {"name": "vkDestroyPipeline", "method": "Destroy"},
      {"name": "vkGetRayTracingShaderGroupHandlesKHR", "method": "GetRayTracingShaderGroupHandles"},
      {"name": "vkGetRayTracingCaptureReplayShaderGroupHandlesKHR", "method": "GetRayTracingCaptureReplayShaderGroupHandles"},
      {"name": "vkCompileDeferredNV", "method": "CompileDeferred"},
      {"name": "vkCreateRayTracingPipelinesNV", "impl": "success_only", "return": "VK_SUCCESS"},
