      }
    },
    "Device": {
      "vk_handle_type": "VkDevice",
      "xgl_class_name": "Device",
      "api_prefix": true,  // Core class - use ApiDevice
      "function_prefix_to_strip": "Device",
      "embedded_handles": {
        "struct_types": [],
        "access_patterns": {},
      },
    },
    "Fence": {
      "vk_handle_type": "VkFence",
      "xgl_class_name": "Fence",
      "api_prefix": false,
      "function_prefix_to_strip": "Fence",
      "embedded_handles": {
