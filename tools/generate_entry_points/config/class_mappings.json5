      "xgl_class_name": "Image",
      "api_prefix": false,
      "function_prefix_to_strip": "Image",
      "embedded_handles": {
        "struct_types": ["VkImageMemoryRequirementsInfo2", "VkImageSparseMemoryRequirementsInfo2"],
        "access_patterns": {
          "VkImageMemoryRequirementsInfo2": "pInfo->image",
          "VkImageSparseMemoryRequirementsInfo2": "pInfo->image"
        }
      }
    },
    "ImageView": {
      "vk_handle_type": "VkImageView",
