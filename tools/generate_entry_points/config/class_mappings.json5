      "function_prefix_to_strip": "DescriptorPool",
      "embedded_handles": {
        "struct_types": [],
        "access_patterns": {}
      }
    },
    "DescriptorSet": {
      "vk_handle_type": "VkDescriptorSet",
      "xgl_class_name": "DescriptorSet",
