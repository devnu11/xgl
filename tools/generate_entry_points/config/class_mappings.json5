        "access_patterns": {
          "VkMemoryMapInfo": "pMemoryMapInfo->memory",
          "VkMemoryUnmapInfo": "pMemoryUnmapInfo->memory",
          "VkMemoryGetFdInfoKHR": "pGetFdInfo->memory",
